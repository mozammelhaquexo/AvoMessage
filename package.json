{
  "name": "avomessage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "prestart": "node -e \"if(!require('fs').existsSync('.next/BUILD_ID')){console.error('No .next build found - run npm run build first.');process.exit(1)}\"",
    "start": "NODE_ENV=production tsx server.ts",
    "start:compiled": "NODE_ENV=production node dist-server/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "supabase:sql": "node scripts/build-supabase-sql.mjs",
    "supabase:sql:check": "node scripts/build-supabase-sql.mjs --check",
    "supabase:verify": "node scripts/verify-supabase-sql.mjs",
    "realtime:smoke": "node scripts/socket-smoke.mjs",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
