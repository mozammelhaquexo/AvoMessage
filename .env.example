# AvoMessage — environment variables (copy to .env and fill in).
# NEVER commit a real .env. Every var the app reads is documented here.

# ── Database ────────────────────────────────────────────────────────────────
# Prisma connection string. Dev (local postgres): see docker-compose.yml.
DATABASE_URL="postgresql://avomessage:avomessage_dev_pw@localhost:5432/avomessage_dev"
#
# Verify any value before trusting it:  npm run db:check
# It reports the failing layer (DNS / TCP / TLS / auth / schema) and names the
# same error code the API would return for that failure.
#
# SUPABASE (and any serverless host — Vercel included). Three things bite here,
# each one producing a different opaque failure:
#
#  1. USE THE POOLER, NOT THE DIRECT HOST. `db.<ref>.supabase.co` is IPv6-only
#     and Vercel's functions are IPv4-only, so a direct string can never connect.
#     The pooler is IPv4.
#
#  2. THE POOLER HOST IS REGION-SCOPED. `aws-0-<region>.pooler.supabase.com`
#     only knows projects in that region; asking the wrong one answers
#     "tenant/user <ref> not found". Copy the exact host from
#     Supabase -> Project Settings -> Database -> Connection string rather than
#     guessing the region.
#
#  3. ADD ?sslmode=no-verify. node-postgres treats `sslmode=require` as
#     `verify-full`, and Supabase's pooler presents a self-signed root, so the
#     plain `require` spelling fails with SELF_SIGNED_CERT_IN_CHAIN. Without any
#     sslmode at all, `pg` silently opens a PLAINTEXT session.
#
# Shape of a working string (session mode, port 5432):
# DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify"
# Transaction mode (port 6543) also works and is friendlier to serverless
# concurrency; keep 5432 for `prisma migrate deploy`.
#
# The schema must exist on whichever database this points at, or every table
# query fails while `SELECT 1` still succeeds. Run the root `supabase.sql` once
# (it is idempotent) or `npx prisma migrate deploy`.
#
# CONNECTION POOLING. Every instance holds its own pool, so on a serverless host
# the pool size multiplies by the number of warm instances. `pg` defaults to 10,
# which exhausted a database during a traffic burst:
#
#   Raw query failed. Code: `53300`.
#   Message: `too many connections for role "prisma_migration"`
#
# `/api/health` went `degraded` and login answered 500 until the idle instances
# went cold. The defaults are now 3 connections per instance on Vercel (10
# elsewhere) with a 5 s idle timeout, which returns connections promptly. Raise
# DATABASE_POOL_MAX only if a single instance genuinely needs more concurrency,
# and prefer the provider's *pooler* endpoint when it has one.
# DATABASE_POOL_MAX="3"
# DATABASE_IDLE_TIMEOUT_MS="5000"

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL used in email links (verification, reset, invitations).
APP_URL="http://localhost:3000"
# development | production
NODE_ENV="development"
# Port for the custom Next+Socket.io server (server.ts).
PORT="3000"
# Bind address for the custom server. Defaults to 0.0.0.0 (all interfaces).
# Set to 127.0.0.1 to bind loopback-only (e.g. when a reverse proxy terminates
# TLS in front of the app).
# HOSTNAME="0.0.0.0"

# ── Auth ────────────────────────────────────────────────────────────────────
# ≥32 bytes of randomness; signs session cookies (HMAC-SHA256). Rotate = logout everyone.
SESSION_SECRET=""
# NOTE: there is deliberately no CSRF signing secret. CSRF protection is
# double-submit (random per-session token in cookie + echoed header, compared
# constant-time) — no server-side state and nothing to sign. A CSRF_SECRET
# entry is reserved for future use and is NOT read by the current code.
# bcrypt cost factor for password hashing. Minimum 10, default 12.
BCRYPT_ROUNDS="12"

# ── Mailer ──────────────────────────────────────────────────────────────────
# log | resend | smtp
#   log    → dev default: writes to console + ./storage/mail/<ts>-<tag>.html
#   resend → RESEND_API_KEY required
#   smtp   → SMTP_* required
MAILER_DRIVER="log"
# RESEND_API_KEY=""
# SMTP_HOST="" SMTP_PORT="587" SMTP_USER="" SMTP_PASSWORD="" SMTP_FROM="noreply@example.com"
# SMTP_SECURE=""            # "1" forces TLS; auto-enabled when SMTP_PORT=465
# Directory for the "log" driver's saved emails (default ./storage/mail).
# MAILER_LOG_DIR="./storage/mail"

# ── Storage ─────────────────────────────────────────────────────────────────
# local | s3
#   local → files under STORAGE_LOCAL_DIR, served by GET /uploads/[...path]
#   s3    → S3-compatible (AWS or MinIO); keys look like <kind>/<yyyy>/<mm>/<uuid>-<name>
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# S3_ENDPOINT=""          # e.g. https://s3.amazonaws.com or http://localhost:9000 (MinIO)
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_PUBLIC_URL=""        # CDN/public base URL prefix for stored objects

# ── Realtime ────────────────────────────────────────────────────────────────
# Where the browser opens the Socket.io connection (same origin in dev/prod).
# Leave UNSET on a serverless host: there is no Socket.io endpoint there, and a
# same-origin default is what the custom server expects anyway.
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
#
# Which transport the browser uses (lib/realtime/transport.ts):
#   auto   (default) — try Socket.io; fall back to REST polling if it cannot
#                      connect. Correct on any host, at the cost of a short
#                      failed connection attempt where Socket.io is absent.
#   socket — Socket.io only. Requires a long-lived Node process (server.ts).
#   poll   — REST polling only. ~3 s latency, no typing indicators.
#
# SET THIS TO "poll" ON VERCEL. Vercel never runs server.ts, so `/socket.io`
# answers 308 → the HTML app instead of a handshake and the socket can never
# connect. Forcing `poll` skips that doomed attempt, so live updates start
# immediately instead of after the fallback fires.
# NEXT_PUBLIC_REALTIME_TRANSPORT="poll"
#
# How often the polling transport re-reads the server, in ms (default 3000).
# Lower is snappier and more requests; raise it on a metered plan.
# NEXT_PUBLIC_REALTIME_POLL_MS="3000"
#
# Comma-separated origins allowed to open a Socket.io connection.
# Defaults to APP_URL when unset. Must list your public origin(s) in prod,
# e.g. "https://app.example.com". (lib/realtime/server.ts)
# SOCKET_ALLOWED_ORIGINS="https://app.example.com"

# ── WebRTC ICE ──────────────────────────────────────────────────────────────
# STUN is enough for most dev NATs; TURN_* is REQUIRED for production reliability.
# Server-side STUN_URL/TURN_URL/TURN_USERNAME/TURN_CREDENTIAL are RESERVED for
# the future ephemeral-credential endpoint (GET /api/calls/turn-credentials)
# and are not read by the current code — the browser client reads the
# NEXT_PUBLIC_* copies below (lib/webrtc/ice-config.ts).
# SECURITY: static long-lived TURN credentials must never ship in the client
# bundle. For production, prefer ephemeral TURN REST credentials minted
# server-side; see docs/SECURITY_REVIEW.md §5.
# STUN_URL="stun:stun.l.google.com:19302"
# TURN_URL=""              # e.g. turn:turn.example.com:3478
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
#
# Browser-visible copies for the WebRTC client (lib/webrtc/ice-config.ts reads
# these; NEXT_PUBLIC_* is the only env the client bundle can see).
# NEXT_PUBLIC_STUN_URL defaults to stun:stun.l.google.com:19302 when unset.
NEXT_PUBLIC_STUN_URL="stun:stun.l.google.com:19302"
# NEXT_PUBLIC_TURN_URL=""
# NEXT_PUBLIC_TURN_USERNAME=""
# NEXT_PUBLIC_TURN_CREDENTIAL=""

# ── Rate limiting (in-memory token bucket in v1; see lib/rate-limit.ts) ─────
# Per-preset limits are hardcoded in RATE_LIMITS (auth 10/min, register 5/hr,
# write 60/min, read 300/min, upload 20/hr). RATE_LIMIT_DEFAULT_PER_MIN is the
# fallback when a call site doesn't name a preset (default 300).
# RATE_LIMIT_DEFAULT_PER_MIN="300"
# Set to "1" to disable the limiter entirely. Used by the vitest suite
# (tests/setup.ts); NEVER set in production.
# RATE_LIMIT_DISABLED=""

# ── Cron / background (in-process scheduler in server.ts) ───────────────────
# CLEANUP_INTERVAL_MIN="60"   # expired tokens/invitations sweep
# PRESENCE_SWEEP_INTERVAL_S="60"

# ── Seed ────────────────────────────────────────────────────────────────────
# prisma db seed refuses to run with NODE_ENV=production unless this is "1".
# Demo accounts (admin@ / manager@ / demo*@avomessage.demo) are DEV ONLY —
# never seed production with them.
# ALLOW_DEMO_SEED=""

# ── Scripts ─────────────────────────────────────────────────────────────────
# Port used by scripts/socket-smoke.mjs when booting a throwaway server.
# SMOKE_PORT="3100"

# ── Security headers / CSP (see docs/SECURITY_REVIEW.md §6) ─────────────────
# enforce (default) | report-only (log violations, don't block) | off
# CSP_MODE="enforce"
