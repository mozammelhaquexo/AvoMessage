# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# avomessage runtime data (never commit)
storage/
uploads/

# compiled custom-server output (rebuilt via `npm run build:server`)
/dist-server/

# embedded Postgres cluster (local dev database — 60MB+ of binaries that change
# on every write; never belongs in git or in a deploy)
/.embedded-pg/

# local archive of removed source files
/.trash/

.vercel
.env*
# ...except the template, which holds no secrets and is the only way a fresh
# clone learns which variables exist. Deliberately the LAST .env rule in this
# file: gitignore is order-sensitive, and `vercel link` appends a bare `.env*`
# here, which would otherwise re-ignore the template.
!.env.example
