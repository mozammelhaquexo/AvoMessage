# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# avomessage runtime data (never commit)
#
# `storage/` covers the upload dir (STORAGE_LOCAL_DIR defaults to
# ./storage/uploads). Do NOT add a bare `uploads/` line here: a gitignore
# pattern with no leading slash matches at EVERY depth, so `uploads/` also
# swallowed app/api/uploads/ — the upload API itself. Both route files went
# uncommitted, and because Vercel now deploys from git rather than from a
# local working tree, every deploy shipped without an upload endpoint:
# POST /api/uploads returned 404 "Server action not found." and profile and
# company picture uploads failed with "Request failed (404)".
# Scope any such pattern to the root: `/uploads/`.
storage/

# compiled custom-server output (rebuilt via `npm run build:server`)
/dist-server/

# embedded Postgres cluster (local dev database — 60MB+ of binaries that change
# on every write; never belongs in git or in a deploy)
/.embedded-pg/

# local archive of removed source files
/.trash/

.vercel
.env*
# ...except the template, which holds no secrets and is the only way a fresh
# clone learns which variables exist. Deliberately the LAST .env rule in this
# file: gitignore is order-sensitive, and `vercel link` appends a bare `.env*`
# here, which would otherwise re-ignore the template.
!.env.example
